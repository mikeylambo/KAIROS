[resource]
script = ExtResource("1_ug4kl")
items = PackedStringArray("Thirty minutes. I spent every one.", "Brighter than the world could hold. That was enough.", "Nothing could touch me. Only this.", "I was never meant to stay. Only to burn.", "Remember the light, not the length.")
