signal node_consumed(id: StringName)
signal lair_revealed()
signal insight_found(id: StringName)
signal tutorial_beat(name: StringName)
signal bloom_phase(n: int)
signal threat_ended(early: bool)
signal clash_changed(value: float)
signal toast(text: String)
signal line_spoken(text: String)
signal map_toggled(open: bool)
