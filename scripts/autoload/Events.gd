extends Node
## Presentation bus. Gameplay emits; VFX/HUD/audio/camera listen. Listeners never
## mutate gameplay state.

signal hit_landed(pos: Vector2, kind: StringName, damage: float, chain: int)
signal launched(pos: Vector2, dir: Vector2)
signal transmitted(from: Vector2, to: Vector2, chase: bool)
signal perfect_guard(pos: Vector2)
signal guarded(pos: Vector2)
signal zenith_hit(pos: Vector2, cost: float)
signal enemy_killed(pos: Vector2, id: StringName)
signal enemy_windup(pos: Vector2)
signal burst(pos: Vector2, dir: Vector2)
signal field_fired(pos: Vector2, radius: float)
signal volley_fired(pos: Vector2)
signal beam_charge(pos: Vector2, frac: float)
signal beam_started(pos: Vector2)
signal beam_ended(pos: Vector2, finisher: bool)
signal whiff(pos: Vector2)
signal jumped(pos: Vector2)
signal terrain_impact(pos: Vector2)
signal world_break(pos: Vector2)
signal hitstop(frames: int)
signal shake(px: float)
signal flash(amount: float)
signal chain_changed(n: int)
signal threshold_ready(index: int, options: Array)
